{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.OpenTelemetry", "Serilog.Enrichers.Environment", "Serilog.Enrichers.Thread"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Grpc": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"],
    "Properties": {
      "Application": "Game.Realtime"
    }
  },
  "ConnectionStrings": {
    "Valkey": "localhost:6379,abortConnect=false,connectTimeout=5000"
  },
  "Jwt": {
    "Secret": "SET_VIA_USER_SECRETS_OR_ENVIRONMENT",
    "Issuer": "Game.Server",
    "Audience": "Game.Client"
  },
  "GameServer": {
    "BaseUrl": "http://localhost:5000"
  },
  "UnityServer": {
    "ServerAddress": "127.0.0.1",
    "ServerPort": 7777
  },
  "Matchmaking": {
    "ProcessingIntervalSeconds": 2,
    "GameModes": {
      "survival": {
        "MatchSize": 4
      }
    }
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}
