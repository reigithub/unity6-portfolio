{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Grpc": "Information"
    }
  },
  "ConnectionStrings": {
    "Valkey": "localhost:6379,abortConnect=false,connectTimeout=5000"
  },
  "Jwt": {
    "Secret": "your-secret-key-must-be-at-least-32-characters-long",
    "Issuer": "Game.Server",
    "Audience": "Game.Client"
  },
  "Matchmaking": {
    "ProcessingIntervalSeconds": 2,
    "GameModes": {
      "survival": {
        "MatchSize": 4
      }
    }
  },
  "Hosting": {
    "ShutdownTimeoutSeconds": 60
  },
  "AllowedHosts": "*"
}
