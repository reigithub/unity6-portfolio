{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "FluentMigrator": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://localhost:18889",
          "Protocol": "Grpc",
          "ResourceAttributes": {
            "service.name": "game-server"
          }
        }
      }
    ]
  },
  "RequestSigning": {
    "SecretKey": "dev-signing-secret-key-must-be-at-least-32-characters",
    "Enabled": true
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=gameserver;Username=gameuser;Password=gamepassword",
    "Valkey": "localhost:6379,abortConnect=false,connectTimeout=5000"
  }
}
