{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "FluentMigrator": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "OpenTelemetry",
        "Args": {
          "Endpoint": "http://localhost:18889",
          "Protocol": "Grpc",
          "ResourceAttributes": {
            "service.name": "game-server"
          }
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Valkey": "localhost:6379,abortConnect=false,connectTimeout=5000"
  }
}
