     // 特定の警告のみエラーとして扱う
    <WarningsAsErrors>CA2000;CA2007</WarningsAsErrors>
  </PropertyGroup>
  -->

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" VersionOverride="3.33.5" />
    <ProjectReference Include="..\Game.Shared\Game.Shared.csproj" />
    <ProjectReference Include="..\Game.Server.Shared\Game.Server.Shared.csproj" />
  </ItemGroup>

</Project>
