/* SurvivorStageConnectScene Styles */

.connect-root {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    justify-content: center;
    align-items: center;
}

/* Status */

.status-container {
    justify-content: center;
    align-items: center;
}

.status-label {
    font-size: 64px;
    -unity-font-style: bold;
    color: white;
    -unity-text-align: middle-center;
}

/* Error */

.error-container {
    justify-content: center;
    align-items: center;
}

.error-label {
    font-size: 24px;
    color: rgb(255, 100, 100);
    -unity-text-align: middle-center;
    margin-bottom: 32px;
    white-space: normal;
    max-width: 600px;
}

.error-buttons {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

/* Buttons */

.connect-button {
    font-size: 20px;
    -unity-font-style: bold;
    padding: 12px 32px;
    margin: 0 8px;
    border-radius: 8px;
    border-width: 2px;
}

.connect-button--primary {
    background-color: rgb(60, 120, 200);
    border-color: rgb(80, 140, 220);
    color: white;
}

.connect-button--primary:hover {
    background-color: rgb(80, 140, 220);
}

.connect-button--secondary {
    background-color: rgb(80, 80, 80);
    border-color: rgb(120, 120, 120);
    color: rgb(200, 200, 200);
}

.connect-button--secondary:hover {
    background-color: rgb(100, 100, 100);
}
